MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=booth-radar
PORT=3001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# OpenAI — used for the AI-generated welcome greeting (optional; falls back to static text if unset)
OPENAI_API_KEY=

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs must include:
#   - Development: http://localhost:3001/api/auth/google/callback
#   - Production:  https://<your-railway-domain>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Session ────────────────────────────────────────────────────────────────────
# Strong random string for signing session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── Production origin ──────────────────────────────────────────────────────────
# Full URL of the deployed app (e.g. https://booth-radar.railway.app).
# Used to build the Google OAuth callback URL in production.
# Leave unset in local development (defaults to http://localhost:3001).
BASE_URL=

# ── Access control (optional) ──────────────────────────────────────────────────
# Comma-separated list of allowed email domains.
# If set, only Google accounts from these domains can sign in.
# If unset, any Google account is allowed.
# Example: ALLOWED_EMAIL_DOMAINS=yourco.com,partner.com
ALLOWED_EMAIL_DOMAINS=
