# LLM backend — Hermes Agent (recommended), OpenAI, or Ollama
HERMES_BASE_URL=
HERMES_MODEL=
HERMES_API_KEY=

# How Hermes calls Booth Radar's tools:
#   inline – <tool> blocks in the reply, parsed by the worker (no VM setup needed)
#   mcp    – native tool calls through mcp_server.py (see README "Hermes MCP setup")
AGENT_TOOL_MODE=inline
# Max seconds without data from Hermes in mcp mode (tools run inside one request)
AGENT_STREAM_TIMEOUT=900

# Tool bridge the MCP server forwards calls to (127.0.0.1 only). mcp_server.py
# reads these from this file. Generate the token with: openssl rand -hex 32
TOOL_BRIDGE_PORT=8765
TOOL_BRIDGE_TOKEN=
TOOL_BRIDGE_TIMEOUT=900

# Page extraction model: a plain OpenAI-compatible chat model, so each page is
# one completion instead of a Hermes agent run. Free option: Ollama on the VM
# (EXTRACT_BASE_URL=http://localhost:11434/v1, EXTRACT_MODEL=qwen2.5:7b-instruct).
# Leave EXTRACT_MODEL empty to keep extracting through Hermes.
EXTRACT_BASE_URL=
EXTRACT_MODEL=
EXTRACT_API_KEY=

# Server WebSocket URL
SERVER_WS_URL=wss://your-server.up.railway.app/ws

# Scraping limits (longer pages are extracted in chunks of this size)
MAX_PAGE_CHARS=40000
# Read server-rendered pages over plain HTTP; only JavaScript pages use Chromium
SCRAPE_HTTP_FIRST=true
# Parallel extraction-model calls (pages and data-feed batches)
EXTRACT_CONCURRENCY=6
# Max records read from one site data feed (WordPress / Shopify / captured API)
MAX_FEED_RECORDS=2000
# Learn per-site layouts so repeated pages and feed batches skip the extraction model
RECIPES_ENABLED=true
# RECIPES_PATH=/home/<user>/booth-radar/worker/data/recipes.json
# Pages scraped/extracted at once (one warm Chromium per slot)
SCRAPE_CONCURRENCY=4
# Max wait for a page to go network-idle before using the current DOM
SCRAPE_IDLE_TIMEOUT_MS=8000

# In-memory cache of scraped pages and extractions (0 disables)
PAGE_CACHE_TTL=3600
PAGE_CACHE_MAX=300

# LLM limits
REQUEST_TIMEOUT=120
MAX_TOKENS=8192

# Opening line shown when Hermes starts working before it says anything.
# Generated by ACK_MODEL on OpenAI (needs OPENAI_API_KEY); falls back to a
# fixed message if the key is missing or no reply arrives within ACK_WAIT_SECONDS.
OPENAI_API_KEY=
ACK_MODEL=gpt-4o-mini
ACK_WAIT_SECONDS=4

# Agent limits
AGENT_MAX_STEPS=12
AGENT_PAGE_CHARS=12000
MAX_URLS_PER_CALL=40

# Files Hermes creates are offered as chat downloads.
# OUTPUT_ROOT: per-conversation folders Hermes is told to save into
#   (must be writable by the user Hermes runs as).
# ARTIFACT_ROOTS: comma-separated folders files may be delivered from
#   (defaults to OUTPUT_ROOT). Never include folders that hold secrets.
OUTPUT_ROOT=/home/jomael/booth-radar-outputs
ARTIFACT_ROOTS=/home/jomael/booth-radar-outputs,/home/jomael
ARTIFACT_MAX_BYTES=10485760
ARTIFACT_MAX_FILES=5
