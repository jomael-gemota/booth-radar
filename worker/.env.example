# LLM backend — Hermes Agent (recommended), OpenAI, or Ollama
HERMES_BASE_URL=http://localhost:8642/v1
HERMES_MODEL=hermes-agent
HERMES_API_KEY=your-secret-key

# MongoDB (same as server)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=booth-radar

# Server WebSocket URL
SERVER_WS_URL=ws://localhost:3001/ws

# Scraping limits
MAX_PAGE_CHARS=40000

# LLM limits
REQUEST_TIMEOUT=120
MAX_TOKENS=8192
